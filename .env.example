# Скопируйте в .env.local и при необходимости поменяйте.

# Пустой DATABASE_URL — встроенная база PGlite в .data/pglite (ничего ставить не нужно).
# Для PostgreSQL / Supabase / Docker:
# DATABASE_URL=postgres://gavko:gavko@localhost:5432/gavko
DATABASE_URL=

# Общий пароль тестовых сотрудников (admin, editor, archivist, ridder, moderator, analyst, siteadmin).
# Только для демо-стенда. На публичном стенде задайте свой и передайте комиссии отдельно.
DEMO_PASSWORD=demo-gavko-2026

# Помощник «Ахмет». Без ключа отвечает по каталогу по шаблону с пометкой «демо».
# OpenRouter (по умолчанию модель deepseek/deepseek-v4.1-flash):
OPENROUTER_API_KEY=
# или Anthropic (по умолчанию claude-opus-5-5):
ANTHROPIC_API_KEY=
# Явный выбор поставщика и модели (необязательно):
# AKHMET_PROVIDER=openrouter
# AKHMET_MODEL=deepseek/deepseek-v4.1-flash
# Лимиты обращений к модели: в сутки на весь сайт и на одного посетителя за 10 минут
AI_DAILY_LIMIT=200
AI_PER_IP_PER_10MIN=12
